# Local development values. Copy to .env; .env is not tracked.
# Change these two if something else on your machine owns 9000.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

BUCKET_BRONZE=bronze
BUCKET_SILVER=silver
BUCKET_GOLD=gold
